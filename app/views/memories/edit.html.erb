<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-4">Edit Chat Memory</h1>

  <div class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4">
    <%= form_with(model: @memory, url: chat_memory_path(@chat), method: :patch) do |form| %>
      <% if @memory.errors.any? %>
        <div id="error_explanation" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
          <strong class="font-bold">Holy smokes!</strong>
          <span class="block sm:inline"><%= pluralize(@memory.errors.count, "error") %> prohibited this memory from being saved:</span>
          <ul>
            <% @memory.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-4">
        <%= form.label :summary, class: "block text-gray-700 text-sm font-bold mb-2" %>
        <%= form.text_area :summary, rows: 10, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
      </div>

      <div class="flex items-center justify-between">
        <%= form.submit "Update Memory", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded cursor-pointer" %>
        <%= link_to 'Cancel', chat_memory_path(@chat), class: "inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800" %>
      </div>
    <% end %>
  </div>
</div>
