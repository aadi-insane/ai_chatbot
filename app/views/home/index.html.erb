<% if user_signed_in? %>
  <div class="d-flex" style="height: 90vh;">
    <!-- Sidebar -->
    <div class="sidebar border-end p-3" style="width: 200px; overflow-y: auto;">
      <h4>Your Chats</h4>

      <%= link_to "➕ New Chat", root_path, class: "btn btn-sm btn-primary mb-3" %>

      <%= render @chats %>
    </div>

    <!-- Chat Window -->
    <div class="flex-grow-1 p-3" style="margin-right: 10%; margin-bottom: 2%; margin-top: -2%">
      <div class="chat-container border border-dark h-100 d-flex flex-column">
        <h1 class="text-center text-primary p-2">Ask the Rails AI Chatbot</h1>

        <div class="chat-window flex-grow-1 overflow-auto p-3" id="chat-window">
          <!-- Messages will appear here -->
        </div>

        <div class="input-container p-2 border-top d-flex gap-2">
          <input type="text" id="question" placeholder="Ask me anything..."
                 autocomplete="off" class="form-control" />
          <button id="submit-btn" type="submit" class="btn btn-primary">Submit</button>
        </div>
      </div>
    </div>
  </div>

  <style>
    .message {
      margin-bottom: 10px;
      padding: 10px;
      border-radius: 10px;
      max-width: 80%;
    }
    .user {
      background-color: #dcf8c6;
      align-self: flex-end;
    }
    .chatbot {
      background-color: #f1f0f0;
      align-self: flex-start;
    }
    .chat-window {
      display: flex;
      flex-direction: column;
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      let currentChatId = null;
      const chatWindow = document.getElementById("chat-window");
      const questionInput = document.getElementById("question");
      const submitButton = document.getElementById("submit-btn");
      const sidebar = document.querySelector(".sidebar");

      // Function to append a message to the chat window
      function appendMessage(html) {
        chatWindow.insertAdjacentHTML('beforeend', html);
        scrollToBottom();
      }

      // Function to scroll the chat window to the bottom
      function scrollToBottom() {
        chatWindow.scrollTop = chatWindow.scrollHeight;
      }

      // Function to clear the chat window
      function clearChatWindow() {
        chatWindow.innerHTML = "";
      }

      // Function to set the active chat in the sidebar
      function setActiveChat(chatLink) {
        // Remove active class from all chat items
        sidebar.querySelectorAll('.chat-item a').forEach(link => link.classList.remove('active'));
        // Add active class to the clicked chat item
        if (chatLink) {
          chatLink.classList.add('active');
        }
      }

      // Handle new message submission
      submitButton.addEventListener("click", function(e) {
        e.preventDefault();
        const question = questionInput.value;
        if (!question) return;

        questionInput.value = "";

        const typingIndicator = document.createElement("div");
        typingIndicator.className = "typing-indicator";
        typingIndicator.textContent = "AI is typing...";
        chatWindow.appendChild(typingIndicator);
        scrollToBottom();

        const payload = {
          message: { content: question }
        };
        if (currentChatId) {
          payload.chat_id = currentChatId;
        }

        fetch("/messages", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content
          },
          body: JSON.stringify(payload),
        })
        .then((response) => response.json())
        .then((data) => {
          typingIndicator.remove();
          if (data.error) {
            appendMessage(`<div class="message chatbot"><div class="message-content"><p>${data.error}</p></div></div>`);
          } else {
            if (!currentChatId) {
              currentChatId = data.chat_id;
              // Add the new chat to the sidebar
              const newChatItem = document.createElement('div');
              newChatItem.className = 'chat-item mb-2';
              const newChatLink = document.createElement('a');
              newChatLink.href = `/chats/${currentChatId}`;
              newChatLink.className = 'd-block text-decoration-none';
              newChatLink.textContent = `Chat #${currentChatId}`;
              newChatLink.dataset.chatId = currentChatId;
              newChatItem.appendChild(newChatLink);
              const newChatButton = sidebar.querySelector('a[data-turbo-method="post"]');
              newChatButton.parentNode.insertBefore(newChatItem, newChatButton.nextSibling);
              setActiveChat(newChatLink);
            }
            appendMessage(data.user_message_html);
            appendMessage(data.bot_message_html);
          }
          scrollToBottom();
        })
        .catch((error) => {
          typingIndicator.remove();
          appendMessage(`<div class="message chatbot"><div class="message-content"><p>Sorry, I am having trouble responding right now.</p></div></div>`);
          scrollToBottom();
        });
      });

      // Handle chat selection from the sidebar
      sidebar.addEventListener('click', function(e) {
        if (e.target.tagName === 'A' && e.target.dataset.chatId) {
          e.preventDefault();
          const chatId = e.target.dataset.chatId;
          currentChatId = chatId;
          clearChatWindow();
          setActiveChat(e.target);

          fetch(`/chats/${chatId}`, {
            headers: {
              "Accept": "application/json"
            }
          })
          .then(response => response.json())
          .then(html_messages => {
            html_messages.forEach(message_html => {
              appendMessage(message_html);
            });
          });
        }
      });

      // Add data-chat-id to existing chat links
      sidebar.querySelectorAll('.chat-item a').forEach(link => {
        const path = link.getAttribute('href');
        if (path !== '/chats') {
          const chatId = path.split('/').pop();
          link.dataset.chatId = chatId;
        }
      });
    });
  </script>
<% else %>
  <div class="text-center">
    <h1>Welcome to the AI Chatbot</h1>
    <p>Please sign in to use the chatbot.</p>
    <%= link_to 'Sign In', new_user_session_path, class: 'btn btn-primary' %>
  </div>
<% end %>
