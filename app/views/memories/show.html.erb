<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-4">Chat Memory</h1>

  <div class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4">
    <h2 class="text-xl font-semibold mb-2">Current Summary</h2>
    <div class="prose max-w-none">
      <% if @memory.summary.present? %>
        <p><%= simple_format(@memory.summary) %></p>
      <% else %>
        <p class="text-gray-500">No memory summary has been generated for this chat yet.</p>
      <% end %>
    </div>
  </div>

  <%= link_to 'Edit', edit_chat_memory_path(@chat), class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  <%= link_to 'Back to Chat', root_path, class: "text-gray-600 hover:text-gray-800 ml-4" %>
</div>